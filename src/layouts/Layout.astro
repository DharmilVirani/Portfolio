---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import SocialLogo from '../components/SocialLogo.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; }
const { title = 'Dharmil Virani — Software Developer', description = profile.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const isHome = Astro.url.pathname === '/';
const gmailCompose = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(profile.email)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ee" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={Astro.site ? new URL('/social-card.png', Astro.site).href : '/social-card.png'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="brand" href="/" aria-label="Dharmil Virani, home"><BrandMark /><span class="brand-name">Dharmil Virani<span>Software developer</span></span></a>
      <nav aria-label="Main navigation">
        <a href={isHome ? '#work' : '/#work'}>Work</a>
        <a href={isHome ? '#about' : '/#about'}>About</a>
        <a href={isHome ? '#experience' : '/#experience'}>Experience</a>
        <a class="nav-contact" href={isHome ? '#contact' : '/#contact'}>Let’s talk <Icon name="external" /></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer id="contact" class="site-footer">
      <div class="container">
        <div class="section-kicker"><span>04 / START A CONVERSATION</span><span>Good things begin with hello.</span></div>
        <div class="contact-main"><h2>Something in mind?<br /><a href={gmailCompose} target="_blank" rel="noopener noreferrer">Let’s build it.<Icon name="external" /></a></h2><p>Have an interesting problem, a role in mind,<br class="desktop-break" /> or just want to talk software?<br />I’d love to hear from you.</p></div>
        <div class="contact-links"><a class="email-link" href={gmailCompose} target="_blank" rel="noopener noreferrer">{profile.email} <Icon name="external" /></a><button class="copy-email js-only" data-email={profile.email} aria-label="Copy email address"><Icon name="copy" /><span data-copy-label>Copy email</span></button><span id="copy-status" class="sr-only" role="status"></span><div class="social-links"><a class="social-logo" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><SocialLogo name="github" /></a><a class="social-logo" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><SocialLogo name="linkedin" /></a><a href={profile.resume} download aria-label="Download resume">Résumé <Icon name="down" /></a></div></div>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Dharmil Virani</span><span>Made with care. Built with intent.</span><a href="#main">Back to top ↑</a></div>
      </div>
    </footer>
    <script>
      document.documentElement.classList.add('js');
      const copy = document.querySelector<HTMLButtonElement>('.copy-email');
      let copyTimer: ReturnType<typeof setTimeout>;
      copy?.addEventListener('click', async () => {
        const label = copy.querySelector('[data-copy-label]');
        const status = document.querySelector('#copy-status');
        try {
          await navigator.clipboard.writeText(copy.dataset.email || '');
          if (label) label.textContent = 'Copied!';
          if (status) status.textContent = 'Email address copied to clipboard.';
        } catch {
          if (label) label.textContent = 'Select email to copy';
          if (status) status.textContent = 'Clipboard unavailable. Select the email address or use the email link.';
        }
        clearTimeout(copyTimer);
        copyTimer = setTimeout(() => { if (label) label.textContent = 'Copy email'; }, 3500);
      });
    </script>
  </body>
</html>

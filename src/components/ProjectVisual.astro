---
interface Props { type: string; large?: boolean; }
const { type, large = false } = Astro.props;
const heights = [26, 39, 34, 58, 44, 62, 77, 66, 83, 71, 91, 82, 96, 89, 112, 103, 123, 113, 105, 132, 122, 145, 130, 150];
---
<div class:list={['project-visual', `visual-${type}`, { 'visual-large': large }]} aria-hidden="true">
  {type === 'signal' && <div class="signal-window"><div class="window-top"><span class="window-dots">● ● ●</span><span>SIGNAL / WORKSPACE</span><span class="window-state">◉ RESEARCH</span></div><div class="signal-inner"><div class="signal-side"><span class="signal-logo">S/</span><i></i><i></i><i></i><i></i></div><div class="signal-content"><div class="signal-head"><span>Market overview<small>From events to decisions.</small></span><span class="demo-badge">ILLUSTRATIVE DATA</span></div><div class="signal-readout"><span>Event pipeline<small>Ingest → Process → Publish</small></span><span class="signal-check">CONNECTED ↗</span></div><div class="candles">{heights.map((h, i) => <span class:list={['candle', { negative: i % 4 === 0 }]} style={`--h:${h}px;--offset:${Math.round(h * .65)}px`} />)}</div><div class="signal-axis"><span>09:15</span><span>10:30</span><span>11:45</span><span>13:00</span></div><div class="signal-pipeline"><span><i></i> WebSocket</span><b>→</b><span>Rust engine</span><b>→</b><span>Interface</span></div></div></div></div>}
  {type === 'medicine' && <div class="medicine-window"><div class="window-top"><span class="medicine-logo">✳</span><span>VETERINARY DRUG INDEX</span><span>— □</span></div><div class="medicine-body"><div class="medicine-sidebar"><span class="medicine-active">▦ &nbsp; Medicine index</span><span>↥ &nbsp; Import records</span><span>↧ &nbsp; Export</span></div><div class="medicine-main"><span class="mini-eyebrow">YOUR LOCAL WORKSPACE</span><h4>A little more organized.</h4><div class="medicine-search">⌕ &nbsp; Find a medicine or species <span>⌘ K</span></div><div class="medicine-table"><div><span>REFERENCE</span><span>SPECIES</span><span>STATUS</span></div>{['Reference A', 'Reference B', 'Reference C'].map((name, i) => <div><span><i class="record-icon">+</i>{name}</span><span>{['Canine', 'Feline', 'Bovine'][i]}</span><span class="record-tag">Indexed</span></div>)}</div><span class="mini-footnote">CONCEPT VIEW · NO CLINICAL DATA</span></div></div></div>}
  {type === 'typing' && <div class="typing-art"><div class="typing-art-header"><span>turbo<span class="typing-name">typist</span><span class="typing-dot">.</span></span><span>THE FLOW STATE</span></div><div class="typing-words">a little <span>focus</span><br />goes a long way<span class="typing-caret"></span></div><div class="keyboard-art">{['T', 'Y', 'P', 'E'].map((letter, index) => <span class:list={{ 'key-active': index === 2 }}>{letter}</span>)}</div><div class="typing-art-footer"><span>SMALL DETAILS. BETTER FEEDBACK.</span><span>↗</span></div></div>}
  {type === 'food' && <div class="food-art"><div class="food-art-header"><span>foodie</span><span>GOOD FOOD. GOOD MOOD.</span><span>Bag (2)</span></div><div class="food-art-body"><div><span class="mini-eyebrow">A LITTLE CRAVING?</span><h4>Find your<br />next favourite.</h4><span class="food-browse">Explore the menu ↗</span></div><div class="food-plate"><div class="food-bun top-bun"></div><div class="food-lettuce"></div><div class="food-tomato"></div><div class="food-patty"></div><div class="food-bun bottom-bun"></div><span class="food-spark">✳</span></div></div><div class="food-art-footer"><span>Browse.</span><span>Choose.</span><span>Make it yours.</span></div></div>}
  {type === 'tool' && <div class="tool-art"><span class="tool-bracket">&#123;</span><span>build something<br /><strong>useful.</strong></span><span class="tool-bracket">&#125;</span></div>}
</div>

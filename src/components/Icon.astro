---
interface Props { name?: 'arrow' | 'down' | 'external' | 'copy' | 'plus' | 'close' | 'menu'; class?: string; }
const { name = 'arrow', class: className } = Astro.props;
const paths = {
  arrow: 'M4 12h15M13 5l7 7-7 7',
  down: 'M12 4v15M5 13l7 7 7-7',
  external: 'M5 19 19 5M5 5h14v14',
  copy: 'M9 9h11v11H9zM15 9V4H4v11h5',
  plus: 'M12 4v16M4 12h16',
  close: 'm5 5 14 14M5 19 19 5',
  menu: 'M4 8h16M4 16h16',
};
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
